---
import '../styles/globals.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  mesLabel?: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
}

const {
  title,
  description = 'La Data — Informe mensual de la quiniela argentina. Análisis estadístico por Tomás Vera.',
  mesLabel = '',
  image = '/og-default.png',
  type = 'article',
  canonical,
} = Astro.props;

const pageTitle = `${title} · SaleHoy`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(image, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="-hv7KUNR1Rb3K3wjBI26XpX-wojsFTE6kzS8vMsdAp4" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="SaleHoy" />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="SaleHoy" href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Analytics -->
    <Analytics />

    <!-- JSON-LD inyectado por cada página de La Data -->
    <slot name="head" />
  </head>
  <body>
    <!-- Topbar mínima: sin el header global del sitio -->
    <div class="ld-topbar">
      <a href="/la-sala" class="ld-topbar-logo-link">
        <img
          src="/img/logos/logo-lasala-neon.png"
          alt="La Sala · SaleHoy"
          class="ld-logo-mark"
          style="height:32px;width:auto;display:block;"
        />
      </a>
      <span class="ld-room">La sala · La Data</span>
      <span class="ld-edition">{mesLabel}</span>
    </div>

    <slot />
  </body>
</html>

<style>
  body {
    background: var(--paper-warm);
    color: var(--ink);
    font-family: var(--font-sans);
    min-height: 100vh;
    margin: 0;
    padding: 0;
  }

  .ld-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 28px 12px;
    border-bottom: 1px solid var(--ink-line);
    background: var(--paper-warmer);
    gap: 16px;
    flex-wrap: wrap;
  }

  .ld-topbar-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .ld-room {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    flex: 1;
    text-align: center;
  }

  .ld-edition {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cuero);
  }

  @media (max-width: 820px) {
    .ld-topbar { padding: 14px 20px 10px; gap: 8px; }
    .ld-room { display: none; }
    .ld-logo-mark { height: 28px !important; }
  }
</style>
