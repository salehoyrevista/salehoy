---
// Plantilla de las obras nuevas ("El interruptor", "El minuto") y de sus páginas de texto.
// Pone la cabecera (título, descripción, canónica, alternativa es/en, vista previa), las
// tipografías y colores del sitio, la marca de tráfico propio y la medición. El cuerpo es libre.
//
//   texto   -> true para páginas de lectura (términos, archivo): aplica los estilos de prosa.
//   nav     -> false para que la página ubique <NavObras /> donde quiera.
import NavObras from "../components/NavObras.astro";
import { SITIO } from "../lib/obras.js";

const {
  lang = "es",
  obra = "",              // "interruptor" | "minuto"
  titulo,
  descripcion,
  ruta,                   // p. ej. "/interruptor/"
  alterna = null,         // la misma página en el otro idioma: { lang, href }
  imagen = "/og.png",     // vista previa (ruta absoluta dentro del sitio)
  indexar = true,
  texto = false,
  nav = true,
  ld = null
} = Astro.props;
const url = SITIO + ruta;
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0d12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/interno.js"></script>
    <title>{titulo} — Solzimer</title>
    <meta name="description" content={descripcion} />
    <meta name="author" content="Solzimer" />
    {!indexar && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={url} />
    {alterna && <link rel="alternate" hreflang={lang} href={url} />}
    {alterna && <link rel="alternate" hreflang={alterna.lang} href={SITIO + alterna.href} />}
    {alterna && <link rel="alternate" hreflang="x-default" href={SITIO + (lang === "en" ? ruta : alterna.href)} />}
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Solzimer" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={SITIO + imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary_large_image" />
    {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    <slot name="head" />
  </head>
  <body class={texto ? "texto" : ""} data-obra={obra}>
    {nav && <header class="obra-arriba"><NavObras lang={lang} actual={obra} /></header>}
    <slot />
    <script is:inline src="/visita.js" defer></script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Instrument Serif"; font-style: normal; font-weight: 400; font-display: swap;
    src: url("/fonts/instrument-serif.woff2") format("woff2");
  }
  @font-face {
    font-family: "Instrument Serif"; font-style: italic; font-weight: 400; font-display: swap;
    src: url("/fonts/instrument-serif-italic.woff2") format("woff2");
  }
  @font-face {
    font-family: "IBM Plex Mono"; font-style: normal; font-weight: 400; font-display: swap;
    src: url("/fonts/ibm-plex-mono.woff2") format("woff2");
  }
  :root {
    --tinta: #0e0d12;
    --crema: #f2e9d8;
    --tenue: rgba(242, 233, 216, 0.6);
    --linea: rgba(242, 233, 216, 0.16);
    --bermellon: #e2553a;
    --serif: "Instrument Serif", Georgia, "Times New Roman", serif;
    --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: var(--tinta); color: var(--crema); }
  body { min-height: 100vh; min-height: 100svh; font-family: var(--serif); overflow-x: hidden; }
  [hidden] { display: none !important; }
  a { color: var(--bermellon); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 1px solid var(--bermellon); outline-offset: 4px; }
  .obra-arriba { position: relative; z-index: 5; padding: max(16px, env(safe-area-inset-top)) 16px 0; }

  /* páginas de lectura */
  body.texto main { width: 100%; max-width: 44rem; padding: 9vh 16px 64px clamp(16px, 9vw, 7rem); }
  body.texto h1 { margin: 0 0 1.5rem; font-weight: 400; font-size: clamp(2.5rem, 7.5vw, 4.8rem); line-height: .98; letter-spacing: -.012em; }
  body.texto h1 em { color: var(--tenue); }
  body.texto h2 { margin: 2.75rem 0 .75rem; font-weight: 400; font-size: clamp(1.6rem, 3.6vw, 2.1rem); line-height: 1.1; }
  body.texto p, body.texto li { font-size: 1.25rem; line-height: 1.5; overflow-wrap: break-word; }
  body.texto p { margin: 0 0 1rem; }
  body.texto ul, body.texto ol { margin: 0 0 1rem; padding-left: 1.3rem; }
  body.texto li { margin-bottom: .45rem; }
  body.texto .entrada { font-size: clamp(1.4rem, 3vw, 1.7rem); line-height: 1.35; }
  body.texto .dato, body.texto .mono { font-family: var(--mono); font-size: .76rem; line-height: 1.7; color: var(--tenue); }
  body.texto code { font-family: var(--mono); font-size: .8em; word-break: break-all; }
</style>
