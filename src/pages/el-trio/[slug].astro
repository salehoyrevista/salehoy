---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const recomendaciones = await getCollection('recomendaciones');
  return recomendaciones.map(reco => ({
    params: { slug: reco.id },
    props: { reco },
  }));
}

const { reco } = Astro.props;
const { Content } = await render(reco);

const narradores = await getCollection('narradores');
const narrador = narradores.find(n => n.data.slug === (reco.data.narrador ?? 'el-cronista'));

const todasRecos = await getCollection('recomendaciones');
const siblings = todasRecos
  .filter(r => r.data.edicion === reco.data.edicion && r.id !== reco.id)
  .sort((a, b) => {
    const order = ['pelicula', 'libro', 'disco'];
    return order.indexOf(a.data.tipo) - order.indexOf(b.data.tipo);
  });

const tipoLabel: Record<string, string> = { pelicula: 'Película', libro: 'Libro', disco: 'Disco' };
const tipoGlyph: Record<string, string> = { pelicula: '▶', libro: '◆', disco: '◉' };
const enlaceLabel: Record<string, string> = { pelicula: 'Dónde verla', libro: 'Conseguir el libro', disco: 'Escuchar el disco' };

const formatFecha = (d: Date) => d.toLocaleDateString('es-AR', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const meta = [reco.data.autor, reco.data.anio].filter(Boolean).join(' · ');
---

<BaseLayout
  title={`${reco.data.titulo} · El Trío`}
  description={reco.data.bajada || `${tipoLabel[reco.data.tipo]}: ${reco.data.titulo} — recomendación cultural de SaleHoy.`}
  type="article"
  image={reco.data.imagen || '/og-default.svg'}
>
  <article class="reco">
    <div class="reco__shell">

      <a href="/el-trio" class="reco__back">← El Trío</a>

      <header class="reco__head">
        <span class="reco__eyebrow">El Trío · {tipoLabel[reco.data.tipo]}</span>
        <h1 class="reco__title">{reco.data.titulo}</h1>
        {meta && <p class="reco__meta">{meta}</p>}
        {narrador && (
          <p class="reco__firma">
            Por <a href={`/narradores/${narrador.data.slug}`}>{narrador.data.nombreReal ?? narrador.data.nombre}</a>
            {' · '}{formatFecha(reco.data.fecha)}
          </p>
        )}
      </header>

      <div class={`reco__cover reco__cover--${reco.data.tipo}`}>
        {reco.data.imagen
          ? <img src={reco.data.imagen} alt={reco.data.titulo} />
          : <span class="reco__ph">{tipoLabel[reco.data.tipo]}</span>}
      </div>

      {reco.data.bajada && <p class="reco__bajada">{reco.data.bajada}</p>}

      <div class="reco__body">
        <Content />
      </div>

      {reco.data.enlaceObra && (
        <a href={reco.data.enlaceObra} class="reco__cta" target="_blank" rel="sponsored noopener">
          {enlaceLabel[reco.data.tipo]} →
        </a>
      )}

      {siblings.length > 0 && (
        <aside class="reco__siblings">
          <p class="reco__siblings-label">El Trío completo</p>
          <div class="reco__siblings-grid">
            {siblings.map(s => (
              <a href={`/el-trio/${s.id}`} class={`sib sib--${s.data.tipo}`}>
                <span class="sib__glyph" aria-hidden="true">{tipoGlyph[s.data.tipo]}</span>
                <div class="sib__body">
                  <span class="sib__tipo">{tipoLabel[s.data.tipo]}</span>
                  <strong class="sib__titulo">{s.data.titulo}</strong>
                  {s.data.autor && <span class="sib__autor">{s.data.autor}</span>}
                </div>
                <span class="sib__arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </aside>
      )}

    </div>
  </article>
</BaseLayout>

<style>
  .reco {
    background: var(--color-bg);
    color: var(--color-text);
    padding: 56px 0 88px;
  }
  .reco__shell {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .reco__back {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-text-secondary);
    transition: color 120ms ease;
  }
  .reco__back:hover { color: var(--color-accent-red); }
  .reco__cta {
    display: inline-block;
    margin: 36px 0 8px;
    padding: 13px 24px;
    border-radius: 8px;
    background: var(--color-accent-gold);
    color: var(--color-bg);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    transition: background 140ms ease;
  }
  .reco__cta:hover { background: #e0bd4a; }

  .reco__head { margin: 22px 0 26px; }
  .reco__eyebrow {
    font-family: var(--font-display);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 14px;
    color: var(--color-leather);
    display: block;
    margin-bottom: 8px;
  }
  .reco__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(30px, 5vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .reco__meta {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-text-secondary);
    margin: 12px 0 0;
  }
  .reco__firma {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-tertiary);
    margin: 6px 0 0;
  }
  .reco__firma a { color: var(--color-leather); text-decoration: none; }
  .reco__firma a:hover { text-decoration: underline; }

  .reco__cover {
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-line);
    margin-bottom: 26px;
  }
  .reco__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .reco__ph {
    font-family: var(--font-display);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.14em;
    font-size: 24px;
    color: var(--color-bg);
    opacity: 0.92;
  }
  .reco__cover--pelicula { background: var(--color-accent-red); }
  .reco__cover--libro    { background: var(--color-leather); }
  .reco__cover--disco    { background: var(--color-text); }

  .reco__bajada {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 28px;
    text-wrap: pretty;
  }

  .reco__body {
    font-family: var(--font-display);
    font-size: 19px;
    line-height: 1.72;
    color: var(--color-text);
  }
  .reco__body :global(p) { margin: 0 0 1.2em; }
  .reco__body :global(h2) {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    margin: 1.6em 0 0.5em;
  }

  /* ── Siblings (El Trío completo) ── */
  .reco__siblings {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--color-line);
  }
  .reco__siblings-label {
    font-family: var(--font-body);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    font-size: 13px;
    color: var(--color-text-tertiary);
    margin: 0 0 16px;
  }
  .reco__siblings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .sib {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms ease, transform 120ms ease;
  }
  .sib:hover {
    border-color: var(--color-accent-gold);
    transform: translateY(-2px);
  }

  .sib__glyph {
    font-size: 18px;
    opacity: 0.55;
    line-height: 1;
  }
  .sib--pelicula .sib__glyph { color: var(--color-accent-red); opacity: 1; }
  .sib--libro    .sib__glyph { color: var(--color-leather); opacity: 1; }
  .sib--disco    .sib__glyph { color: var(--color-text-secondary); opacity: 1; }

  .sib__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .sib__tipo {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
  .sib__titulo {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sib__autor {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-tertiary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sib__arrow {
    font-size: 16px;
    color: var(--color-text-tertiary);
    transition: color 120ms ease, transform 120ms ease;
  }
  .sib:hover .sib__arrow {
    color: var(--color-accent-gold);
    transform: translateX(3px);
  }

  @media (max-width: 620px) {
    .reco { padding: 40px 0 64px; }
    .reco__shell { padding: 0 22px; }
    .reco__body { font-size: 17px; }
    .reco__siblings-grid { grid-template-columns: 1fr; }
  }
</style>
