---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const recos = (await getCollection('recomendaciones'))
  .sort((a, b) => (b.data.fecha?.valueOf() ?? 0) - (a.data.fecha?.valueOf() ?? 0));

// Agrupar por edición
const porEdicion = recos.reduce<Record<string, typeof recos>>((acc, r) => {
  const ed = r.data.edicion ?? 'sin-edicion';
  if (!acc[ed]) acc[ed] = [];
  acc[ed].push(r);
  return acc;
}, {});

const edicionesOrdenadas = Object.keys(porEdicion).sort((a, b) => b.localeCompare(a));

const tipoLabel: Record<string, string> = { pelicula: 'Película', libro: 'Libro', disco: 'Disco' };
const tipoGlyph: Record<string, string> = { pelicula: '▶', libro: '◆', disco: '◉' };
---

<BaseLayout
  title="El Trío · SaleHoy"
  description="Una película, un libro, un disco. Lo que los narradores de SaleHoy están mirando, leyendo y escuchando."
>
  <section class="trio-index">
    <div class="trio-index__shell">

      <header class="trio-index__head">
        <span class="eyebrow">Recomendaciones</span>
        <h1 class="trio-index__title">El Trío</h1>
        <p class="trio-index__desc">Una película, un libro, un disco. Lo que los narradores de SaleHoy están mirando, leyendo y escuchando.</p>
      </header>

      {edicionesOrdenadas.map(ed => {
        const grupo = porEdicion[ed];
        const ordenTipo = ['pelicula', 'libro', 'disco'];
        const ordenado = [...grupo].sort((a, b) =>
          ordenTipo.indexOf(a.data.tipo) - ordenTipo.indexOf(b.data.tipo)
        );
        return (
          <div class="trio-edicion">
            <p class="trio-edicion__label">Número {ed}</p>
            <div class="trio-edicion__grid">
              {ordenado.map(r => (
                <a href={`/el-trio/${r.id}`} class={`trio-card trio-card--${r.data.tipo}`}>
                  <div class="trio-card__cover">
                    {r.data.imagen
                      ? <img src={r.data.imagen} alt={r.data.titulo} loading="lazy" />
                      : <span class="trio-card__ph">{tipoGlyph[r.data.tipo]}</span>}
                  </div>
                  <div class="trio-card__body">
                    <span class="trio-card__tipo">{tipoLabel[r.data.tipo]}</span>
                    <strong class="trio-card__titulo">{r.data.titulo}</strong>
                    {r.data.autor && <span class="trio-card__autor">{r.data.autor}</span>}
                    {r.data.bajada && <p class="trio-card__bajada">{r.data.bajada}</p>}
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}

    </div>
  </section>
</BaseLayout>

<style>
  .trio-index {
    padding: 56px 0 88px;
  }
  .trio-index__shell {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .trio-index__head {
    margin-bottom: 56px;
  }
  .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 13px;
    color: var(--color-leather);
    margin-bottom: 8px;
  }
  .trio-index__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, 6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .trio-index__desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: var(--color-text-secondary);
    max-width: 560px;
    margin: 0;
  }

  .trio-edicion {
    margin-bottom: 64px;
  }
  .trio-edicion__label {
    font-family: var(--font-body);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    font-size: 12px;
    color: var(--color-text-tertiary);
    margin: 0 0 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-line);
  }
  .trio-edicion__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .trio-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 120ms ease, transform 120ms ease;
  }
  .trio-card:hover {
    border-color: var(--color-accent-gold);
    transform: translateY(-3px);
  }

  .trio-card__cover {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .trio-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 280ms ease;
  }
  .trio-card:hover .trio-card__cover img {
    transform: scale(1.04);
  }
  .trio-card__ph {
    font-size: 32px;
    opacity: 0.7;
    color: var(--color-bg);
  }
  .trio-card--pelicula .trio-card__cover { background: var(--color-accent-red); }
  .trio-card--libro    .trio-card__cover { background: var(--color-leather); }
  .trio-card--disco    .trio-card__cover { background: var(--color-text); }

  .trio-card__body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }
  .trio-card__tipo {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
  .trio-card__titulo {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
  }
  .trio-card__autor {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-tertiary);
  }
  .trio-card__bajada {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: 6px 0 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 720px) {
    .trio-edicion__grid { grid-template-columns: 1fr; }
    .trio-index { padding: 40px 0 64px; }
    .trio-index__shell { padding: 0 22px; }
  }
  @media (min-width: 721px) and (max-width: 900px) {
    .trio-edicion__grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
