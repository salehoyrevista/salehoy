    <div class="nota" id="nota" hidden>
      <section class="nota-panel" role="dialog" aria-modal="true" aria-labelledby="notaTitulo">
        <button class="cerrar" id="cerrarNota" type="button" data-t-aria="cerrar" aria-label="cerrar">✕</button>
