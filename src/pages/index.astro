---
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const articulos = await getCollection('articulos');
const ediciones = await getCollection('ediciones');
const narradores = await getCollection('narradores');

const edicionActual = ediciones.sort((a, b) =>
  b.data.fecha.valueOf() - a.data.fecha.valueOf()
)[0];

// Mapa narrador slug → datos completos del narrador
const narradorMap = new Map(narradores.map(n => [n.data.slug, n.data]));

// Imágenes de portada por convención de nombre. Soporta .webp (nuevo) o .png
// (convención original del #01) según qué archivo exista.
function heroPath(suffix: 'h' | 'v') {
  const webp = new URL(`../../public/img/portadas/${edicionActual.id}-${suffix}.webp`, import.meta.url);
  if (fs.existsSync(webp)) return `/img/portadas/${edicionActual.id}-${suffix}.webp`;
  return `/img/portadas/${edicionActual.id}-${suffix}.png`;
}
const heroH = heroPath('h');
const heroV = heroPath('v');

// Universos: última recomendación (El Trío) y última voz
const recomendaciones = await getCollection('recomendaciones');
const ultimaReco = recomendaciones
  .sort((a, b) => (b.data.fecha?.valueOf() ?? 0) - (a.data.fecha?.valueOf() ?? 0))[0];

const voces = await getCollection('voces');
const ultimaVoz = voces
  .sort((a, b) => (b.data.fecha?.valueOf() ?? 0) - (a.data.fecha?.valueOf() ?? 0))[0];

// Destacados: artículos marcados del número actual (max 3); fallback a los 3 más recientes
const articulosNumero = articulos.filter(a => a.data.edicion === edicionActual.data.numero);
const conDestacado = articulosNumero.filter(a => a.data.destacado);
const articulosDestacados = (conDestacado.length > 0 ? conDestacado : articulosNumero)
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="SaleHoy"
  description="Revista cultural del juego y el azar. Quiniela, casino, póker, caballos, online: pensados con seriedad."
>
  <div class="sh-home">

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <img
        class="hero__img hero__img--desk"
        src={heroH}
        alt={`Portada del número #${edicionActual.data.numero} de SaleHoy.`}
        width="1376"
        height="620"
      />
      <img
        class="hero__img hero__img--mob"
        src={heroV}
        alt={`Portada del número #${edicionActual.data.numero} de SaleHoy.`}
        width="768"
        height="1100"
      />
      <div class="hero__scrim-top" aria-hidden="true"></div>
      <div class="hero__scrim-bot" aria-hidden="true"></div>
      <div class="hero__content">
        <div class="hero__wordmark" aria-hidden="true">Sale<span class="hoy">Hoy</span></div>
        <div class="hero__foot">
          <span class="hero__eyebrow">
            Último número · <span class="hero__num">#{edicionActual.data.numero}</span> · {edicionActual.data.titulo}
          </span>
          <p class="hero__tagline">{edicionActual.data.bajada}</p>
          <a href={`/ediciones/${edicionActual.id}`} class="btn-enter">
            Entrar al número <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ TAMBIÉN EN SALEHOY ═══ -->
    <nav class="universos" aria-label="Secciones de SaleHoy">
      <div class="shell universos__grid">

        <a href="/la-sala" class="univ">
          <span class="univ__glyph" aria-hidden="true">★</span>
          <div class="univ__body">
            <span class="univ__label">Zona viva</span>
            <strong class="univ__name">La Sala</strong>
            <p class="univ__desc">La Vichy, La Data, las frases, las anécdotas y el azar del bar.</p>
          </div>
          <span class="univ__arrow" aria-hidden="true">→</span>
        </a>

        {ultimaReco && (
          <a href={`/el-trio/${ultimaReco.id}`} class="univ">
            <span class="univ__glyph" aria-hidden="true">✦</span>
            <div class="univ__body">
              <span class="univ__label">Recomendaciones</span>
              <strong class="univ__name">El Trío</strong>
              <p class="univ__desc">Una película, un libro, un disco. Lo que los narradores están mirando.</p>
            </div>
            <span class="univ__arrow" aria-hidden="true">→</span>
          </a>
        )}

        {ultimaVoz && (
          <a href={`/voces/${ultimaVoz.id}`} class="univ">
            <span class="univ__glyph" aria-hidden="true">{ultimaVoz.data.numero}</span>
            <div class="univ__body">
              <span class="univ__label">Voces del número</span>
              <strong class="univ__name">El {ultimaVoz.data.nombre}</strong>
              <p class="univ__desc">Los cinco narradores leen el mismo número desde su disciplina.</p>
            </div>
            <span class="univ__arrow" aria-hidden="true">→</span>
          </a>
        )}

      </div>
    </nav>

    <!-- ═══ DESTACADOS ═══ -->
    <section class="sh-section" id="destacados">
      <div class="shell">
        <div class="section-head reveal">
          <div class="section-head__lhs">
            <span class="eyebrow">Número #{edicionActual.data.numero} · {edicionActual.data.titulo}</span>
            <h2 class="section-h">Destacados del número</h2>
          </div>
          <a href={`/ediciones/${edicionActual.id}`} class="btn-link">
            Ver el número completo <span class="arrow">→</span>
          </a>
        </div>

        <div class="grid-dest">
          {articulosDestacados.map((art, i) => (
            <ArticleCard
              articulo={art}
              narradorNombre={narradorMap.get(art.data.narrador)?.nombre}
              featured={i === 0}
              size={i === 0 ? 'lg' : 'md'}
              showImagen={i !== 0}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ═══ LA SALA (umbral sobrio) ═══ -->
    <section class="sh-section sala" id="sala">
      <div class="shell">
        <div class="sala__umbral reveal">
          <span class="eyebrow">La sala · zona viva</span>
          <h2 class="section-h">La sala está abierta</h2>
          <p class="section-sub sala__sub">Cinco dispositivos que responden: los números, la quiniela, las frases, las anécdotas y el azar del bar.</p>
          <a href="/la-sala" class="btn-ink sala__cta">
            Ingresar a la sala <span class="arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══ NEWSLETTER ═══ -->
    <section class="sh-section news" id="newsletter">
      <div class="shell news__inner reveal">
        <span class="eyebrow">El newsletter</span>
        <h2 class="section-h">Te llega cuando sale<br>un número nuevo.</h2>
        <p class="section-sub">Sin spam. Sin terceros. Una sola lista, un solo editor.</p>
        <a href="/newsletter" class="btn-ink">
          Suscribirme <span class="arrow">→</span>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  /* ══════════════ UNIVERSOS ══════════════ */
  .universos {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-bg-elevated);
  }

  .universos__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .univ {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-lg);
    text-decoration: none;
    color: inherit;
    border-right: 1px solid var(--color-line);
    transition: background var(--transition-fast);
  }

  .univ:last-child { border-right: none; }

  .univ:hover {
    background: color-mix(in srgb, var(--color-accent-gold) 5%, var(--color-bg-elevated));
  }

  .univ:hover .univ__arrow {
    transform: translateX(3px);
  }

  .univ__glyph {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    font-weight: var(--font-medium);
    color: var(--color-accent-gold);
    line-height: 1;
    opacity: 0.75;
    min-width: 2ch;
    text-align: center;
  }

  .univ__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .univ__label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .univ__name {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    font-size: var(--text-xl);
    color: var(--color-text);
    line-height: 1.1;
  }

  .univ__desc {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.45;
    margin: var(--space-xs) 0 0;
    text-wrap: pretty;
  }

  .univ__arrow {
    font-size: var(--text-lg);
    color: var(--color-text-tertiary);
    transition: transform var(--transition-fast), color var(--transition-fast);
    align-self: center;
  }

  .univ:hover .univ__name { color: var(--color-accent-gold); }
  .univ:hover .univ__arrow { color: var(--color-accent-gold); }

  @media (max-width: 760px) {
    .universos__grid {
      grid-template-columns: 1fr;
    }
    .univ {
      border-right: none;
      border-bottom: 1px solid var(--color-line);
      padding: var(--space-lg);
    }
    .univ:last-child { border-bottom: none; }
  }

  /* ══════════════ HOME ══════════════ */
  .sh-home {
    background: var(--color-bg);
    color: var(--color-text);
  }

  .shell {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: #0a0804;
  }
  .hero__img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .hero__img--desk { aspect-ratio: 1376 / 620; }
  .hero__img--mob  { display: none; aspect-ratio: 768 / 1100; }

  .hero__scrim-top,
  .hero__scrim-bot {
    position: absolute;
    left: 0; right: 0;
    pointer-events: none;
  }
  .hero__scrim-top {
    top: 0;
    height: 34%;
    background: linear-gradient(to bottom, rgba(8,6,4,0.55), transparent);
  }
  .hero__scrim-bot {
    bottom: 0;
    height: 58%;
    background: linear-gradient(to top, rgba(8,6,4,0.72) 0%, rgba(8,6,4,0.18) 60%, transparent 100%);
  }

  .hero__content {
    position: absolute;
    inset: 0;
    padding: 30px 40px 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .hero__wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    letter-spacing: -0.01em;
    color: #F4ECDC;
    text-shadow: 0 1px 14px rgba(0,0,0,.45);
    line-height: 1;
    align-self: flex-start;
  }
  .hero__wordmark .hoy { color: #E2837C; }

  .hero__foot {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }
  .hero__eyebrow {
    font-family: var(--font-body);
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #F4ECDC;
    line-height: 1.4;
  }
  .hero__num { color: #E2837C; }

  .hero__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    color: #F4ECDC;
    opacity: 0.85;
    line-height: 1.4;
    margin: 0;
    max-width: 40ch;
    text-wrap: pretty;
  }

  .btn-enter {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 14px;
    color: var(--color-text);
    background: #F4ECDC;
    border-radius: 4px;
    padding: 12px 22px;
    text-decoration: none;
    transition: background 120ms ease;
  }
  .btn-enter:hover { background: #fff; color: #1A1A1A; }
  .btn-enter:hover .arrow { margin-left: 4px; }
  .btn-enter .arrow { transition: margin-left 120ms ease; }

  /* ---------- SECCIONES ---------- */
  .sh-section {
    padding: 80px 0;
    border-top: 1px solid var(--color-line);
  }
  .sala { border-top: 1px solid var(--color-text); }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    margin-bottom: 40px;
  }
  .section-head__lhs { display: flex; flex-direction: column; gap: 10px; }

  .eyebrow {
    font-family: var(--font-display);
    font-variant-caps: all-small-caps;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--color-leather);
    display: block;
  }
  .section-h {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin: 0;
  }
  .section-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 30ch;
    margin: 0;
    align-self: flex-end;
    text-wrap: pretty;
  }

  /* ---------- GRILLA DESTACADOS ---------- */
  .grid-dest {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .grid-dest :global(.card--featured) {
    grid-column: 1 / -1;
  }

  .btn-link {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-end;
    white-space: nowrap;
    transition: color 120ms ease;
  }
  .btn-link:hover { color: var(--color-accent-red); }
  .btn-link:hover .arrow { margin-left: 2px; }
  .btn-link .arrow { transition: margin-left 120ms ease; }

  /* ---------- LA SALA ---------- */
  .sala__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 32px;
  }
  .sala__head-lhs { display: flex; flex-direction: column; gap: 8px; }

  .btn-ink {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-bg);
    background: var(--color-text);
    border: none;
    padding: 12px 22px;
    text-decoration: none;
    transition: background 120ms ease;
    white-space: nowrap;
  }
  .btn-ink:hover { background: var(--color-accent-red); color: #fff; }
  .btn-ink:hover .arrow { margin-left: 4px; }
  .btn-ink .arrow { transition: margin-left 120ms ease; }

  .sala__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .sala-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 22px 20px;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    position: relative;
    text-decoration: none;
    color: inherit;
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .sala-card:hover { border-color: var(--color-text); transform: translateY(-3px); }
  .sala-card:hover .sala-card__go { color: var(--color-accent-red); }

  .sala-card__crt {
    font-family: 'VT323', 'JetBrains Mono', monospace;
    font-size: 22px;
    color: var(--color-accent-gold);
    opacity: 0.65;
    position: absolute;
    top: 16px; right: 16px;
    line-height: 1;
  }
  .sala-card__num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-leather);
    margin-bottom: 8px;
    display: block;
  }
  .sala-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0 0 8px;
  }
  .sala-card__what {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0;
    flex: 1;
    text-wrap: pretty;
  }
  .sala-card__go {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    color: var(--color-accent-red);
    margin-top: 16px;
    transition: color 120ms ease;
  }

  /* ---------- LA SALA (umbral) ---------- */
  .sala__umbral {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: 16px 0;
  }
  .sala__umbral .section-h { max-width: 20ch; }
  .sala__sub { align-self: center; max-width: 54ch; }
  .sala__cta { margin-top: 10px; font-size: 14px; padding: 14px 28px; }

  /* ---------- EL TRÍO ---------- */
  .trio__box {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 28px;
  }
  .trio__item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .trio__cover {
    aspect-ratio: 3 / 4;
    border-radius: 5px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    border: 1px solid var(--color-line);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }
  .trio__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .trio__item:hover .trio__cover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.12); }
  .trio__ph {
    font-family: var(--font-display);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.1em;
    font-size: 18px;
    color: var(--color-bg);
    opacity: 0.92;
  }
  .trio__cover--pelicula { background: var(--color-accent-red); }
  .trio__cover--libro    { background: var(--color-leather); }
  .trio__cover--disco    { background: var(--color-text); }
  .trio__tipo {
    font-family: var(--font-display);
    font-variant-caps: all-small-caps;
    letter-spacing: 0.12em;
    font-size: 12px;
    color: var(--color-leather);
  }
  .trio__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 19px;
    line-height: 1.18;
    color: var(--color-text);
    margin: 4px 0;
  }
  .trio__item:hover .trio__title { color: var(--color-accent-red); }
  .trio__meta {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  /* ---------- NEWSLETTER ---------- */
  .news {
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-line);
  }
  .news__inner {
    max-width: 720px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .news__inner .section-h { max-width: 18ch; }
  .news__inner .section-sub { max-width: 44ch; }

  /* ---------- ANIMACIONES ---------- */
  @keyframes sh-revealUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .sh-home .reveal.is-in {
    animation: sh-revealUp 600ms cubic-bezier(0.2, 0, 0, 1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .sh-home .reveal.is-in { animation: none; }
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 1100px) {
    .sala__grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .sala__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 760px) {
    .section-head { flex-direction: column; gap: 12px; }
    .section-sub { align-self: auto; max-width: none; }
    .sala__head { flex-direction: column; align-items: flex-start; gap: 16px; }
    .grid-dest { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .shell { padding: 0 22px; }
    .hero__img--desk { display: none; }
    .hero__img--mob  { display: block; }
    .hero__content { padding: 24px 22px 30px; }
    .sh-section { padding: 60px 0; }
    .trio__box { padding: 18px; gap: 14px; }
    .trio__title { font-size: 16px; }