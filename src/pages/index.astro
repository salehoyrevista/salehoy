  * { box-sizing: border-box; }
  html, body {
    margin: 0; height: 100%; overflow: hidden;
    background: var(--tinta); color: var(--crema);
    touch-action: none; -webkit-tap-highlight-color: transparent;
  }
  body { font-family: var(--serif); }

  /* grano de papel: ruido generado, sin imágenes externas */
  body::after {
    content: ""; position: fixed; inset: 0; z-index: 1; pointer-events: none; opacity: .07;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .95 0 0 0 0 .91 0 0 0 0 .85 0 0 0 .9 0'/></filter><rect width='100%' height='100%' filter='url(%23g)'/></svg>");
  }

  #cielo { position: fixed; inset: 0; z-index: 0; display: block; }

  .ui {
    position: fixed; inset: 0; z-index: 2; pointer-events: none;
    transition: opacity 1.2s ease;
  }
  .ui a, .ui button { pointer-events: auto; }
  body.en-prologo .ui, body.en-prologo #cielo { opacity: 0; }
  #cielo { transition: opacity 1.4s ease; }
  body.con-nota .ui, body.con-nota #cielo { opacity: .28; }

  .enlace {
    background: none; border: 0; padding: 0; cursor: pointer;
    font: inherit; color: var(--bermellon);
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px;
  }
  .enlace:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 1px solid var(--bermellon); outline-offset: 4px; }

  .firma {
    position: absolute; top: max(18px, env(safe-area-inset-top)); left: 16px; margin: 0;
    font-family: var(--mono); font-size: .68rem; letter-spacing: .04em; color: var(--tenue);
  }

  .obra {
    position: absolute; left: clamp(16px, 9vw, 10rem); right: 16px; top: 27vh;
    max-width: 62rem;
  }
  h1 {
    margin: 0; font-weight: 400;
    font-size: clamp(2.8rem, 9vw, 7.5rem); line-height: .94; letter-spacing: -.012em;
    transition: opacity .7s ease;
    overflow-wrap: break-word;
  }
  h1.fuera { opacity: 0; }
  .linea { display: block; }
  .sin-motivo { font-style: italic; color: var(--tenue); margin-top: .06em; }
  .ast { display: inline-block; width: .82em; height: .82em; vertical-align: -.08em; overflow: visible; }
  .asterisco {
    background: none; border: 0; padding: .12em; margin-left: .06em; cursor: pointer;
    font-size: .3em; line-height: 1; vertical-align: .9em; color: var(--bermellon);
  }
  .asterisco .ast { width: 1em; height: 1em; display: block; }
  .asterisco:hover { opacity: .75; }

  /* para lectores de pantalla y buscadores: oculto a la vista, no al texto */
  .solo-lectores {
    position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  /* sin JavaScript: el texto de la obra, visible y con scroll */
  .sin-js {
    position: fixed; inset: 0; z-index: 9; overflow-y: auto; touch-action: pan-y;
    padding: 12vh 16px 48px clamp(16px, 9vw, 10rem); background: var(--tinta);
    max-width: 100%; font-size: 1.2rem; line-height: 1.45;
  }
  .sin-js > * { max-width: 36rem; }
  .sin-js h2 { margin: 0 0 .4rem; font-weight: 400; font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 1; }
  .sin-js .dato { font-family: var(--mono); font-size: .75rem; color: var(--tenue); }

  .lema {
    margin: clamp(1.6rem, 4vh, 2.6rem) 0 .7rem; max-width: 30rem;
    font-family: var(--mono); font-size: .75rem; line-height: 1.6; color: var(--tenue);
  }
  .obra .enlace { font-family: var(--mono); font-size: .8rem; }

  .esperando {
    position: absolute; left: 50%; top: 0; margin: 0; transform: translateX(-50%);
    white-space: nowrap; text-align: center;
    font-family: var(--mono); font-size: .68rem; letter-spacing: .03em; color: var(--tenue);
    transition: opacity 1.2s ease;
  }
  .esperando.retirada { opacity: 0; }

  .pie {
    position: absolute; left: 16px; right: 16px; bottom: max(16px, env(safe-area-inset-bottom));
    display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 24px;
    font-family: var(--mono); font-size: .68rem;
  }
  .idiomas { display: flex; flex-wrap: wrap; gap: 2px 12px; }
  .idiomas button {
    background: none; border: 0; padding: 4px 0; cursor: pointer;
    font: inherit; color: var(--tenue);
  }
  .idiomas button[aria-pressed="true"] { color: var(--crema); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .cuenta { margin: 0; color: var(--tenue); }

  .etiqueta {
    position: fixed; left: 0; top: 0; z-index: 3;
    display: flex; gap: 14px; align-items: baseline; white-space: nowrap;
    padding: 7px 10px; background: var(--tinta);
    font-family: var(--mono); font-size: .68rem; color: var(--crema);
    border-left: 1px solid var(--bermellon);
  }
  .etiqueta[hidden] { display: none; }
  .etiqueta { flex-wrap: wrap; max-width: 300px; row-gap: 4px; }
  .etiqueta .momento {
    flex-basis: 100%; white-space: normal;
    font-family: var(--serif); font-style: italic; font-size: .95rem; line-height: 1.25;
    color: var(--crema); opacity: .85;
  }
