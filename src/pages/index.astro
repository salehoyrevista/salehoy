    <script is:inline src="/salehoy.js"></script>
    <script is:inline>
      (function () {
        var S = window.SaleHoy;
        if (!S) return;

        var CREMA = "242,233,216";
        var BERMELLON = "226,85,58";
        var quieto = window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches;

        var lienzo = document.getElementById("cielo");
        var ctx = lienzo.getContext("2d");
        var ui = document.getElementById("ui");
        var titulo = document.getElementById("titulo");
        var regalar = document.getElementById("regalar");
        var notaRegalar = document.getElementById("notaRegalar");
        var cuentaN = document.getElementById("cuentaN");
        var esperando = document.getElementById("esperando");
        var etiqueta = document.getElementById("etiqueta");
        var etiquetaTexto = document.getElementById("etiquetaTexto");
        var copiarEnlace = document.getElementById("copiarEnlace");
        var nota = document.getElementById("nota");
        var registro = document.getElementById("registro");
        var verRegistro = document.getElementById("verRegistro");
        var prologo = document.getElementById("prologo");
        var prologoFrases = document.getElementById("prologoFrases");
        var prologoBoton = document.getElementById("prologoBoton");

        var actual;
        var regalos = null;      // null: sin datos (cargando o la API falló)
        var estrellas = [];
        var resaltado = null;    // n.º pedido con ?n=
        var abierta = null;      // estrella con la etiqueta abierta
        var fijada = false;      // la etiqueta se abrió con un toque o con ?n=

        // ---------- idioma ----------

        function aplicar(lang) {
          actual = lang;
          S.aplicarTextos(lang);
          regalar.href = notaRegalar.href = "/regalo.html?lang=" + lang;
          marcar(lang);
          pintarCuenta();
          if (abierta) mostrarEtiqueta(abierta, fijada);
          if (!registro.hidden) armarRegistro();
          if (!esperando.hidden) ubicarEsperando();
        }

        var marcar = S.fila(document.getElementById("idiomas"), function (lang) {
          pararRotacion();
          aplicar(lang);
        });

        var inicio = S.detectar();
        aplicar(inicio.lang);

        var rotacion = null;
        function pararRotacion() {
          if (rotacion) { clearInterval(rotacion); rotacion = null; }
          titulo.classList.remove("fuera");
        }
        function rotar() {
          if (inicio.elegido || quieto || rotacion) return;
          rotacion = setInterval(function () {
            if (!nota.hidden) return;
            titulo.classList.add("fuera");
            setTimeout(function () {
              if (!rotacion) return;
              var i = S.IDIOMAS.indexOf(actual);
              aplicar(S.IDIOMAS[(i + 1) % S.IDIOMAS.length]);
              titulo.classList.remove("fuera");
            }, 700);
          }, 4000);
        }

        // ---------- forma de cada asterisco, a partir del hash ----------

        function semilla(texto) {
          var h = 1779033703 ^ texto.length;
          for (var i = 0; i < texto.length; i++) {
            h = Math.imul(h ^ texto.charCodeAt(i), 3432918353);
            h = (h << 13) | (h >>> 19);
          }
          var a = h >>> 0;
          return function () {
            a = (a + 0x6D2B79F5) | 0;
            var t = Math.imul(a ^ (a >>> 15), 1 | a);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
          };
        }

        // Zonas libres: no tapar el título, la firma ni el pie.
        function libre(x, y) {
          if (x < 0.8 && y > 0.2 && y < 0.72) return false;
          if (x < 0.4 && y < 0.08) return false;
          if (y > 0.87) return false;
          return true;
        }

        function crearEstrella(regalo) {
          var r = semilla(regalo.clave);
          var puntas = 5 + Math.floor(r() * 4);
          var x, y, intentos = 0;
          do { x = 0.03 + r() * 0.94; y = 0.04 + r() * 0.9; intentos++; } while (!libre(x, y) && intentos < 40);
          var brazos = [];
          for (var i = 0; i < puntas; i++) brazos.push(0.82 + r() * 0.3);
          return {
            n: regalo.n, fecha: regalo.fecha, x: x, y: y,
            puntas: puntas, brazos: brazos,
            tam: 5 + r() * 11,
            grosor: 0.8 + r() * 1.3,
            giro: r() * Math.PI * 2,
            alfa: 0.5 + r() * 0.5,
            periodo: 3500 + r() * 6000,
            fase: r() * Math.PI * 2,
            dx: 0, dy: 0
          };
        }

        // ---------- lienzo ----------

        var ancho = 0, alto = 0, escala = 1, dpr = 1;
        function medir() {
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          ancho = window.innerWidth;
          alto = window.innerHeight;
          lienzo.width = Math.round(ancho * dpr);
          lienzo.height = Math.round(alto * dpr);
          lienzo.style.width = ancho + "px";
          lienzo.style.height = alto + "px";
          escala = Math.max(0.7, Math.min(1.3, Math.min(ancho, alto) / 800));
          if (!esperando.hidden) ubicarEsperando();
          if (abierta) mostrarEtiqueta(abierta, fijada);
          pedirCuadro();
        }

        function dibujarAsterisco(cx, cy, e, color, alfa) {
          var radio = e.tam * escala;
          ctx.strokeStyle = "rgba(" + color + "," + alfa + ")";
          ctx.lineWidth = e.grosor;
          ctx.lineCap = "round";
          ctx.beginPath();
          for (var i = 0; i < e.puntas; i++) {
            var ang = e.giro + (i / e.puntas) * Math.PI * 2;
            ctx.moveTo(cx, cy);
            ctx.lineTo(cx + Math.cos(ang) * radio * e.brazos[i], cy + Math.sin(ang) * radio * e.brazos[i]);
          }
          ctx.stroke();
        }

        // El asterisco que espera al primer regalo: grande, fino, y respira.
        // Cada punta crece desde el centro, una tras otra; queda completo un
        // momento y se borra en orden inverso. Ciclo de 7 s.
        var espera = { x: 0, y: 0, r: 0 };
        var CICLO = 7000, CRECE = 500, PASO = 480, QUIETO_HASTA = 4300, BORRA = 380;

        function suave(x) { return x * x * (3 - 2 * x); }

        function largoPunta(k, u) {
          var inicio = k * PASO;
          var fin = QUIETO_HASTA + (5 - k) * BORRA;
          if (u < inicio) return 0;
          if (u < inicio + CRECE) return suave((u - inicio) / CRECE);
          if (u < fin) return 1;
          if (u < fin + BORRA) return 1 - suave((u - fin) / BORRA);
          return 0;
        }

        // Visible desde el primer instante; se retira con un fundido solo si
        // llegan regalos.
        var esperaVisible = true;
        var retiro = null;
        var FUNDIDO = 1200;

        function retirarEspera() {
          if (retiro !== null) return;
          retiro = performance.now();
          esperando.classList.add("retirada");
          setTimeout(function () { esperando.hidden = true; }, quieto ? 0 : FUNDIDO);
          pedirCuadro();
        }

        function dibujarEspera(ahora) {
          var u = ahora % CICLO;
          var f = 1;
          if (retiro !== null) {
            f = quieto ? 0 : Math.max(0, 1 - (ahora - retiro) / FUNDIDO);
            if (f <= 0) { esperaVisible = false; return; }
          }
          ctx.strokeStyle = "rgba(" + CREMA + "," + ((quieto ? 0.35 : 0.6) * f).toFixed(3) + ")";
          ctx.lineWidth = 1.2;
          ctx.lineCap = "round";
          ctx.beginPath();
          // Empieza (y termina) por una punta diagonal: una sola raya vertical
          // parecería un cursor de texto.
          for (var k = 0; k < 6; k++) {
            var l = quieto ? 1 : largoPunta(k, u);
            if (l <= 0) continue;
            var ang = -Math.PI / 2 + ((k + 1) % 6) * Math.PI / 3;
            ctx.moveTo(espera.x, espera.y);
            ctx.lineTo(espera.x + Math.cos(ang) * espera.r * l, espera.y + Math.sin(ang) * espera.r * l);
          }
          ctx.stroke();
        }

        function brillo(e, t) {
          if (quieto) return 1;
          return 0.72 + 0.28 * Math.sin((t / e.periodo) * Math.PI * 2 + e.fase);
        }

        // ---------- estelas y puntero ----------

        var estela = [];       // puntos {x, y, t} o null para cortar el trazo
        var puntero = null;
        var VIDA = 2000;

        function sumarPunto(x, y) {
          estela.push({ x: x, y: y, t: performance.now() });
          if (estela.length > 600) estela.splice(0, estela.length - 600);
          pedirCuadro();
        }
        function cortar() {
          if (estela.length && estela[estela.length - 1]) estela.push(null);
          puntero = null;
        }

        function dibujarEstela(ahora) {
          while (estela.length && (!estela[0] || ahora - estela[0].t > VIDA)) estela.shift();
          ctx.lineCap = "round";
          for (var i = 1; i < estela.length; i++) {
            var a = estela[i - 1], b = estela[i];
            if (!a || !b) continue;
            var vida = 1 - (ahora - b.t) / VIDA;
            if (vida <= 0) continue;
            ctx.strokeStyle = "rgba(" + CREMA + "," + (0.5 * vida * vida).toFixed(3) + ")";
            ctx.lineWidth = 0.4 + 1.1 * vida;
            ctx.beginPath();
            ctx.moveTo(a.x * dpr, a.y * dpr);
            ctx.lineTo(b.x * dpr, b.y * dpr);
            ctx.stroke();
          }
        }

        // ---------- cuadro ----------

        var pedido = null;
        function pedirCuadro() {
          if (!pedido && !document.hidden) pedido = requestAnimationFrame(cuadro);
        }

        function cuadro(ahora) {
          pedido = null;
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.clearRect(0, 0, lienzo.width, lienzo.height);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          var ultimo = estrellas.length ? estrellas[estrellas.length - 1].n : 0;
          var RADIO = 110;

          for (var i = 0; i < estrellas.length; i++) {
            var e = estrellas[i];
            var px = e.x * ancho, py = e.y * alto;
            if (!quieto) {
              var tx = 0, ty = 0;
              if (puntero) {
                var vx = px - puntero.x, vy = py - puntero.y;
                var d = Math.sqrt(vx * vx + vy * vy);
                if (d < RADIO && d > 0.01) {
                  var f = (1 - d / RADIO);
                  tx = (vx / d) * 16 * f * f;
                  ty = (vy / d) * 16 * f * f;
                }
              }
              e.dx += (tx - e.dx) * 0.06;
              e.dy += (ty - e.dy) * 0.06;
            }
            var cx = px + e.dx, cy = py + e.dy;
            var rojo = e.n === ultimo || e.n === resaltado;
            if (e.n === resaltado) {
              var pulso = quieto ? 0.5 : 0.5 + 0.5 * Math.sin(ahora / 1300);
              var halo = e.tam * escala * (3.2 + pulso * 1.2);
              var g = ctx.createRadialGradient(cx, cy, 0, cx, cy, halo);
              g.addColorStop(0, "rgba(" + BERMELLON + "," + (0.22 + 0.14 * pulso).toFixed(3) + ")");
              g.addColorStop(1, "rgba(" + BERMELLON + ",0)");
              ctx.fillStyle = g;
              ctx.beginPath();
              ctx.arc(cx, cy, halo, 0, Math.PI * 2);
              ctx.fill();
            }
            var alfa = rojo ? 0.95 * (0.85 + 0.15 * brillo(e, ahora)) : e.alfa * brillo(e, ahora);
            dibujarAsterisco(cx, cy, e, rojo ? BERMELLON : CREMA, alfa.toFixed(3));
            e.cx = cx; e.cy = cy;
          }

          if (esperaVisible) dibujarEspera(ahora);

          dibujarEstela(ahora);

          if (abierta && !fijada && abierta.cx != null) ubicarEtiqueta(abierta);

          var mueve = !quieto || estela.length > 0;
          if (mueve) pedirCuadro();
        }

        document.addEventListener("visibilitychange", function () {
          if (document.hidden) { if (pedido) cancelAnimationFrame(pedido); pedido = null; }
          else pedirCuadro();
        });

        // ---------- etiqueta ----------

        function buscarEstrella(x, y) {
          var mejor = null, dist = Infinity;
          for (var i = 0; i < estrellas.length; i++) {
            var e = estrellas[i];
            var ex = e.cx != null ? e.cx : e.x * ancho, ey = e.cy != null ? e.cy : e.y * alto;
            var d = Math.hypot(ex - x, ey - y);
            if (d < Math.max(e.tam * escala + 8, 18) && d < dist) { mejor = e; dist = d; }
          }
          return mejor;
        }

        function ubicarEtiqueta(e) {
          var ex = e.cx != null ? e.cx : e.x * ancho, ey = e.cy != null ? e.cy : e.y * alto;
          var w = etiqueta.offsetWidth, h = etiqueta.offsetHeight;
          var x = Math.min(Math.max(16, ex + 18), ancho - w - 16);
          var y = ey - h - 14;
          if (y < 16) y = ey + 18;
          etiqueta.style.transform = "translate(" + Math.round(x) + "px," + Math.round(y) + "px)";
        }

        function mostrarEtiqueta(e, fijar) {
          abierta = e;
          fijada = !!fijar;
          etiquetaTexto.textContent = S.T[actual].num.replace("{n}", e.n) + " · " + S.hace(e.fecha, actual);
          copiarEnlace.textContent = S.T[actual].copiarEnlace;
          etiqueta.hidden = false;
          ubicarEtiqueta(e);
        }

        function ocultarEtiqueta() {
          abierta = null;
          fijada = false;
          etiqueta.hidden = true;
        }

        copiarEnlace.addEventListener("click", function () {
          if (!abierta) return;
          var url = "https://salehoy.com.ar/?n=" + abierta.n;
          var t = S.T[actual];
          function ok() { copiarEnlace.textContent = t.copiado; setTimeout(function () { copiarEnlace.textContent = S.T[actual].copiarEnlace; }, 1800); }
          if (navigator.clipboard) navigator.clipboard.writeText(url).then(ok, function () { prompt("", url); });
          else prompt("", url);
        });

        function interactivo(el) {
          return el && el.closest && el.closest("a, button, .etiqueta, .nota, .prologo");
        }

        window.addEventListener("pointermove", function (ev) {
          if (!prologo.hidden) return;
          puntero = { x: ev.clientX, y: ev.clientY };
          sumarPunto(ev.clientX, ev.clientY);
          if (ev.pointerType === "mouse" && !fijada && !interactivo(ev.target)) {
            var e = buscarEstrella(ev.clientX, ev.clientY);
            if (e) { if (e !== abierta) mostrarEtiqueta(e, false); lienzo.style.cursor = "pointer"; }
            else { if (abierta) ocultarEtiqueta(); lienzo.style.cursor = ""; }
          }
        }, { passive: true });

        window.addEventListener("pointerdown", function (ev) {
          if (!prologo.hidden || interactivo(ev.target)) return;
          puntero = { x: ev.clientX, y: ev.clientY };
          var e = buscarEstrella(ev.clientX, ev.clientY);
          if (e) mostrarEtiqueta(e, true);
          else if (abierta) ocultarEtiqueta();
        });
        window.addEventListener("pointerup", function (ev) { if (ev.pointerType !== "mouse") cortar(); });
        window.addEventListener("pointercancel", cortar);
        document.documentElement.addEventListener("pointerleave", cortar);
        window.addEventListener("blur", cortar);

        // ---------- regalos ----------

        // Escritorio: mitad derecha, a la altura del título, como contrapeso.
        // Celular: debajo del bloque del título, sin tocar el pie.
        function ubicarEsperando() {
          if (!espera || !ancho) return;   // todavía no se midió el lienzo
          var obra = document.getElementById("obra").getBoundingClientRect();
          var h1 = titulo.getBoundingClientRect();
          var pie = document.querySelector(".pie").getBoundingClientRect();
          var r = Math.round(30 * escala);
          var leyenda = esperando.offsetHeight || 16;
          if (ancho >= 760) {
            espera.x = Math.max(ancho * 0.78, obra.right + r + 40);
            espera.x = Math.min(espera.x, ancho - r - 40);
            espera.y = h1.top + h1.height / 2;
          } else {
            espera.x = ancho / 2;
            var arriba = obra.bottom + 32 + r;
            var tope = pie.top - 24 - leyenda - 14 - r;
            espera.y = Math.max(arriba, Math.min((obra.bottom + pie.top) / 2 - leyenda / 2, tope));
          }
          espera.r = r;
          esperando.style.left = Math.round(espera.x) + "px";
          esperando.style.top = Math.round(espera.y + r + 14) + "px";
          pedirCuadro();
        }

        function pintarCuenta() {
          S.pintarCuenta(cuentaN, regalos);
        }

        S.cargarRegalos().then(function (lista) {
          regalos = lista;
          if (!lista) return;
          estrellas = lista.map(crearEstrella);
          pintarCuenta();
          if (lista.length) retirarEspera();
          var n = parseInt(S.parametro("n"), 10);
          if (n >= 1 && n <= lista.length) {
            resaltado = n;
            var e = estrellas[n - 1];
            e.cx = e.x * ancho; e.cy = e.y * alto;
            mostrarEtiqueta(e, true);
          }
          if (!registro.hidden) armarRegistro();
          pedirCuadro();
        });

        // ---------- nota al pie ----------

        var abrirNota = document.getElementById("abrirNota");

        function abrir() {
          nota.hidden = false;
          document.body.classList.add("con-nota");
          document.getElementById("cerrarNota").focus();
        }
        function cerrar() {
          nota.hidden = true;
          document.body.classList.remove("con-nota");
          abrirNota.focus();
        }
        abrirNota.addEventListener("click", abrir);
        document.getElementById("cerrarNota").addEventListener("click", cerrar);
        nota.addEventListener("click", function (ev) { if (ev.target === nota) cerrar(); });
        document.addEventListener("keydown", function (ev) {
          if (ev.key === "Escape" && !nota.hidden) cerrar();
        });

        function armarRegistro() {
          registro.textContent = "";
          var t = S.T[actual];
          if (!regalos || !regalos.length) {
            var li = document.createElement("li");
            li.textContent = t.vacio;
            registro.appendChild(li);
            return;
          }
          regalos.forEach(function (r) {
            var li = document.createElement("li");
            li.appendChild(document.createTextNode(t.num.replace("{n}", r.n) + " · " + S.fecha(r.fecha, actual) + " · "));
            var a = document.createElement("a");
            a.className = "enlace";
            a.href = "https://base.blockscout.com/tx/" + r.hash;
            a.target = "_blank";
            a.rel = "noopener";
            a.textContent = t.verificar;
            li.appendChild(a);
            registro.appendChild(li);
          });
        }
        verRegistro.addEventListener("click", function () {
          var abrirlo = registro.hidden;
          if (abrirlo) armarRegistro();
          registro.hidden = !abrirlo;
          verRegistro.setAttribute("aria-expanded", abrirlo ? "true" : "false");
        });

        document.getElementById("otraVez").addEventListener("click", function () {
          nota.hidden = true;
          document.body.classList.remove("con-nota");
          correrPrologo();
        });

        // ---------- prólogo ----------

        var MARCA = "salehoy-prologo";
        var relojes = [];
        var enPrologo = false;

        function terminarPrologo() {
          if (!enPrologo) return;
          enPrologo = false;
          relojes.forEach(clearTimeout);
          relojes = [];
          try { localStorage.setItem(MARCA, "1"); } catch (e) {}
          document.removeEventListener("keydown", saltarConTecla);
          prologo.removeEventListener("pointerdown", saltarConToque);
          prologo.classList.add("saliendo");
          document.body.classList.remove("en-prologo");
          setTimeout(function () {
            prologo.hidden = true;
            prologo.classList.remove("saliendo");
          }, quieto ? 0 : 1100);
          rotar();
          pedirCuadro();
        }
        function saltarConTecla(ev) { if (ev.key !== "Tab") terminarPrologo(); }
        function saltarConToque(ev) { if (ev.target !== prologoBoton) terminarPrologo(); }

        function correrPrologo() {
          var t = S.T[actual];
          enPrologo = true;
          ocultarEtiqueta();
          prologoFrases.textContent = "";
          prologo.hidden = false;
          document.body.classList.add("en-prologo");
          prologoBoton.onclick = terminarPrologo;
          document.addEventListener("keydown", saltarConTecla);

          if (quieto) {
            t.prologo.forEach(function (f) {
              var p = document.createElement("p");
              p.textContent = f;
              prologoFrases.appendChild(p);
            });
            prologoBoton.textContent = t.continuar;
            prologoBoton.className = "prologo-boton continuar";
            prologoBoton.focus();
            return;
          }

          prologoBoton.textContent = t.saltear;
          prologoBoton.className = "prologo-boton";
          prologo.addEventListener("pointerdown", saltarConToque);
          var p = document.createElement("p");
          p.className = "frase";
          prologoFrases.appendChild(p);
          var paso = 2000;
          t.prologo.forEach(function (f, i) {
            relojes.push(setTimeout(function () { p.textContent = f; p.classList.add("visible"); }, 300 + i * paso));
            relojes.push(setTimeout(function () { p.classList.remove("visible"); }, 300 + i * paso + 1600));
          });
          relojes.push(setTimeout(terminarPrologo, 300 + t.prologo.length * paso));
        }

        // ---------- arranque ----------

        window.addEventListener("resize", medir);
        medir();
        if (document.fonts && document.fonts.ready) document.fonts.ready.then(medir);

        var visto = false;
        try { visto = localStorage.getItem(MARCA) === "1"; } catch (e) {}
        var conN = S.parametro("n") != null;
        if (!conN && (S.parametro("prologo") === "1" || !visto)) correrPrologo();
        else rotar();
      })();
    </script>
  </body>
</html>

