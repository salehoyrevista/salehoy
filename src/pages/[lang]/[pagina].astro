---
// Páginas de texto generadas desde datos:
// - "regalar una estrella" y "frases" en fr, it, de, zh, ja (src/lib/textos-paginas.js)
// - "sobre la obra" en pt, fr, it, de, zh, ja (src/lib/textos-sobre.js)
// Las direcciones están en RUTAS (src/lib/obra.js).
import Pagina from "../../layouts/Pagina.astro";
import ListaFrases from "../../components/ListaFrases.astro";
import { SITIO, RUTAS, RED, DIRECCION, USDC_BASE, alternativas } from "../../lib/obra.js";
import { ESTRELLA, FRASES } from "../../lib/textos-paginas.js";
import { SOBRE } from "../../lib/textos-sobre.js";

export function getStaticPaths() {
  const caminos = [];
  for (const lang of Object.keys(ESTRELLA)) {
    for (const tipo of ["estrella", "frases"]) {
      const pagina = RUTAS[lang][tipo].split("/")[2];
      caminos.push({ params: { lang, pagina }, props: { tipo } });
    }
  }
  for (const lang of Object.keys(SOBRE)) {
    caminos.push({ params: { lang, pagina: RUTAS[lang].sobre.split("/")[2] }, props: { tipo: "sobre" } });
  }
  return caminos;
}

const { lang } = Astro.params;
const { tipo } = Astro.props;
const r = RUTAS[lang];
const t = tipo === "estrella" ? ESTRELLA[lang] : tipo === "frases" ? FRASES[lang] : SOBRE[lang];
const red = `${RED.nombre}, ${RED.chainId}`;

// {cielo}, {regalo}, etc. por las direcciones de este idioma
const conEnlaces = (html) => html.replace(/\{(cielo|regalo|frases|sobre|estrella)\}/g, (_, k) => r[k]).replace("{red}", red);
const sinHtml = (html) => html.replace(/<[^>]+>/g, "");

const ld = tipo === "sobre"
  ? [
      { "@context": "https://schema.org", "@type": "AboutPage", name: t.titulo, inLanguage: lang, url: SITIO + r.sobre,
        about: { "@type": "VisualArtwork", name: "Sin motivo", artform: "Net art", creator: { "@type": "Person", name: "Solzimer" }, dateCreated: "2026-10-29", url: SITIO + r.cielo } },
      { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: t.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) }
    ]
  : tipo === "estrella"
  ? [
      { "@context": "https://schema.org", "@type": "Article", headline: t.titulo, inLanguage: lang, author: { "@type": "Person", name: "Solzimer" }, datePublished: "2026-11-12", mainEntityOfPage: SITIO + r.estrella, image: SITIO + "/og.png" },
      { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: t.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) }
    ]
  : { "@context": "https://schema.org", "@type": "Article", headline: sinHtml(t.h1), inLanguage: lang, author: { "@type": "Person", name: "Solzimer" }, datePublished: "2026-11-12", mainEntityOfPage: SITIO + r.frases, image: SITIO + "/og.png" };
---
<Pagina
  lang={lang}
  titulo={t.titulo}
  descripcion={t.descripcion}
  ruta={r[tipo]}
  alternativas={alternativas(tipo, lang)}
  ld={ld}
>
  {tipo === "sobre" && (
    <>
      <h1 set:html={t.h1} />
      <p class="entrada" set:html={t.entrada} />
      <p set:html={t.pregunta} />

      <h2>{t.comoTitulo}</h2>
      <ul>{t.como.map((li) => <li set:html={conEnlaces(li)} />)}</ul>

      <h2>{t.fichaTitulo}</h2>
      <p class="mono">
        {t.ficha.titulo}: Sin motivo<br />
        {t.ficha.autor}: Solzimer<br />
        {t.ficha.tipo}: {t.valores.tipo}<br />
        {t.ficha.inicio}: {t.valores.inicio}<br />
        {t.ficha.soporte}: {conEnlaces(t.valores.soporte)}<br />
        {t.ficha.direccion}: <code>{DIRECCION}</code><br />
        {t.ficha.cuentan}: {t.valores.cuentan} (<code>{USDC_BASE}</code>)<br />
        {t.ficha.idiomas}: {t.valores.idiomas}<br />
        {t.ficha.verificar}: <a href={`${RED.explorador}/address/${DIRECCION}`} rel="noopener">{RED.explorador.replace("https://", "")}</a>
      </p>

      <h2>{t.preguntas}</h2>
      {t.faq.map(([q, a]) => (<><h3>{q}</h3><p>{a}</p></>))}

      <p class="accion"><a href={r.cielo}>{t.verCielo}</a> &nbsp; <a href={r.regalo}>{t.regalar}</a></p>

      <hr />
      <p class="dato" set:html={t.cita} />
    </>
  )}
  {tipo === "estrella" && (
    <>
      <h1>{t.h1}</h1>
      <p class="entrada">{t.entrada}</p>

      {t.secciones.map(([titulo, parrafos]) => (
        <>
          <h2>{titulo}</h2>
          {parrafos.map((p) => <p set:html={conEnlaces(p)} />)}
        </>
      ))}

      <h2>{t.otraManera}</h2>
      <p set:html={conEnlaces(t.intro)} />
      <ul>{t.lista.map((li) => <li set:html={conEnlaces(li)} />)}</ul>
      <p set:html={conEnlaces(t.noEs)} />

      <h2>{t.como}</h2>
      <ol>{t.pasos.map((li) => <li set:html={conEnlaces(li)} />)}</ol>
      <p class="accion"><a href={r.regalo}>{t.accion}</a></p>

      <h2>{t.preguntas}</h2>
      {t.faq.map(([q, a]) => (<><h3>{q}</h3><p>{a}</p></>))}

      <hr />
      <p class="dato" set:html={conEnlaces(t.cierre)} />
    </>
  )}
  {tipo === "frases" && (
    <>
      <h1 set:html={t.h1} />
      <p class="entrada">{t.entrada}</p>
      <p>{t.intro}</p>

      <ListaFrases frases={t.frases} copiar={t.copiar} copiado={t.copiado} />

      <p class="dato">{t.nota}</p>

      <h2>{t.usoTitulo}</h2>
      <ul>{t.usos.map((li) => <li set:html={conEnlaces(li)} />)}</ul>

      <h2>{t.porTitulo}</h2>
      {t.por.map((p) => <p set:html={conEnlaces(p)} />)}
      <p class="accion"><a href={r.cielo}>{t.accion}</a></p>
    </>
  )}
</Pagina>
