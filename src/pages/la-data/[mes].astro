---
import LaDataLayout from '../../layouts/LaDataLayout.astro';
import LaData from '../../components/LaData.astro';
import { formatMes, computeMesesNav } from '../../lib/la-data';

export async function getStaticPaths() {
  const datosGlob = import.meta.glob('../../data/la-data/*.datos.json', { eager: true });
  const textosGlob = import.meta.glob('../../data/la-data/*.textos.json', { eager: true });

  const meses = computeMesesNav(datosGlob);

  return Object.keys(datosGlob).map((key) => {
    const mesStr = key.match(/(\d{4}-\d{2})\.datos\.json/)![1];
    const textosKey = Object.keys(textosGlob).find(k => k.includes(mesStr))!;
    return {
      params: { mes: mesStr },
      props: {
        datos: datosGlob[key],
        textos: textosGlob[textosKey] ?? {},
        meses,
        mesStr,
      },
    };
  });
}

const { datos, textos, meses, mesStr } = Astro.props as any;
const mesLabel = formatMes(mesStr);

// ─── SEO / structured data ──────────────────────────────────────────────────
const laDataUrl = new URL(`/la-data/${mesStr}`, Astro.site).toString();
const laDataDesc = `La Data — Informe mensual de la quiniela argentina (${mesLabel}). ${datos.totales.sorteos} sorteos, ${datos.totales.extracciones.toLocaleString('es-AR')} extracciones. Análisis estadístico de Nacional, Buenos Aires y Córdoba por Tomás Vera. No damos picks: mostramos qué pasó, en números.`;

const laDataSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Dataset',
      '@id': `${laDataUrl}#dataset`,
      name: `La Data · Informe mensual de la quiniela · ${mesLabel}`,
      description: laDataDesc,
      url: laDataUrl,
      inLanguage: 'es-AR',
      keywords: ['quiniela', 'estadística', 'Nacional', 'Buenos Aires', 'Córdoba', mesLabel],
      creator: { '@type': 'Person', name: 'Tomás Vera', url: new URL('/narradores/el-matematico', Astro.site).toString() },
      publisher: {
        '@type': 'Organization',
        name: 'SaleHoy',
        url: Astro.site?.toString(),
        logo: { '@type': 'ImageObject', url: new URL('/img/logo-512.png', Astro.site).toString() },
      },
      variableMeasured: ['frecuencia de números', 'desvío vs. promedio teórico', 'distribución por década', 'coincidencias entre zonas'],
      temporalCoverage: mesStr,
    },
    {
      '@type': 'Article',
      '@id': `${laDataUrl}#article`,
      mainEntityOfPage: { '@type': 'WebPage', '@id': laDataUrl },
      url: laDataUrl,
      headline: `La Data · ${mesLabel}`,
      description: laDataDesc,
      image: [new URL('/og/la-data.png', Astro.site).toString()],
      author: { '@type': 'Person', name: 'Tomás Vera', url: new URL('/narradores/el-matematico', Astro.site).toString() },
      publisher: {
        '@type': 'Organization',
        name: 'SaleHoy',
        url: Astro.site?.toString(),
        logo: { '@type': 'ImageObject', url: new URL('/img/logo-512.png', Astro.site).toString() },
      },
      inLanguage: 'es-AR',
      articleSection: 'La Data',
      isPartOf: { '@type': 'CreativeWorkSeries', name: 'La Data · SaleHoy' },
    },
  ],
};
---

<LaDataLayout title={`La Data · ${mesLabel}`} mesLabel={mesLabel} description={laDataDesc} canonical={laDataUrl} image="/og/la-data.png">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(laDataSchema)} />
  <LaData datos={datos} textos={textos} mesLabel={mesLabel} mesStr={mesStr} meses={meses} activeLabel={mesLabel} />
</LaDataLayout>
