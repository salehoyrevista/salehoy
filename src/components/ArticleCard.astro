---
import type { CollectionEntry } from 'astro:content';

interface Props {
  articulo: CollectionEntry<'articulos'>;
  narradorNombre?: string;
  size?: 'sm' | 'md' | 'lg';
  showImagen?: boolean;
  featured?: boolean;
}

const { articulo, narradorNombre, size = 'md', showImagen = false, featured = false } = Astro.props;
const resolvedSize = featured ? 'lg' : size;
const resolvedImagen = featured || showImagen;
const { title, subtitle, narrador, categoria, fecha, tiempoLectura, imagen } = articulo.data;
const href = `/articulos/${articulo.id}`;

const formatFecha = (d: Date) => d.toLocaleDateString('es-AR', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<article class={`card card--${resolvedSize}${featured ? ' card--featured' : ''}`}>
  <a href={href} class="card__link">
    {resolvedImagen && imagen && (
      <div class="card__imagen">
        <img src={imagen} alt="" loading="lazy" />
      </div>
    )}

    <div class="card__body">
      <div class="card__meta">
        <span class={`tag tag-categoria tag--${categoria}`}>{categoria}</span>
        {tiempoLectura && (
          <span class="meta">· {tiempoLectura} min lectura</span>
        )}
      </div>

      <h2 class="card__title">{title}</h2>

      {subtitle && resolvedSize !== 'sm' && (
        <p class="card__subtitle">{subtitle}</p>
      )}

      <div class="card__footer">
        <span class="card__autor">{narradorNombre || narrador.replace('-', ' ')}</span>
        <time class="card__fecha" datetime={fecha.toISOString()}>{formatFecha(fecha)}</time>
      </div>
    </div>
  </a>
</article>

<style>
  .card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    overflow: hidden;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .card:hover {
    border-color: var(--color-accent-gold);
    transform: translateY(-2px);
  }

  .card__imagen {
    margin: calc(var(--space-lg) * -1) calc(var(--space-lg) * -1) var(--space-sm);
    overflow: hidden;
    border-radius: calc(var(--radius-md) - 1px) calc(var(--radius-md) - 1px) 0 0;
  }

  .card__imagen img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  .card:hover .card__imagen img {
    transform: scale(1.03);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    color: inherit;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .card__title {
    font-family: var(--font-display);
    font-weight: var(--font-semibold);
    line-height: var(--leading-snug);
    color: var(--color-text);
    margin: 0;
  }

  .card--sm .card__title { font-size: var(--text-xl); }
  .card--md .card__title { font-size: var(--text-2xl); }
  .card--lg .card__title { font-size: var(--text-3xl); }

  .card__subtitle {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .card__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .card__autor {
    text-transform: capitalize;
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
  }

  /* ── FEATURED (líder de sección) ── */
  /* Ocupa el ancho completo cuando está dentro de un grid */
  .card--featured {
    grid-column: 1 / -1;
  }

  .card--featured .card__link {
    flex-direction: row;
    gap: 0;
  }

  .card--featured .card__imagen {
    flex: 0 0 55%;
    margin: calc(var(--space-lg) * -1) 0 calc(var(--space-lg) * -1) calc(var(--space-lg) * -1);
    border-radius: calc(var(--radius-md) - 1px) 0 0 calc(var(--radius-md) - 1px);
  }

  .card--featured .card__imagen img {
    aspect-ratio: 4 / 3;
    height: 100%;
  }

  .card--featured .card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-left: var(--space-lg);
    justify-content: center;
  }

  .card--featured .card__title {
    font-size: var(--text-3xl);
  }

  @media (max-width: 640px) {
    .card--featured .card__link {
      flex-direction: column;
    }
    .card--featured .card__imagen {
      flex: none;
      margin: calc(var(--space-lg) * -1) calc(var(--space-lg) * -1) var(--space-sm);
      border-radius: calc(var(--radius-md) - 1px) calc(var(--radius-md) - 1px) 0 0;
    }
    .card--featured .card__body {
      padding-left: 0;
    }
  }
</style>
