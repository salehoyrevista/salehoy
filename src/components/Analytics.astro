---
// Google Analytics 4 — SaleHoy
// Reemplazá GA_ID si la propiedad de GA4 cambió. Solo carga en producción.
const GA_ID = 'G-5E838TVWKD';
const enabled = import.meta.env.PROD && !!GA_ID;
---
{enabled && (
  <Fragment>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID);
    </script>
  </Fragment>
)}
